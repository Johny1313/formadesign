{
  "product": "FORMA DESIGN",
  "version": "0.9.7.5.18",
  "ronda_one_in_project": false,
  "projects_page_or_tab": false,
  "save_project_function": true,
  "chart_studio_location": "left tool menu / Gráficos",
  "preserved_integrations": [
    "AI",
    "DB",
    "GIPHY_API_KEY",
    "REMOVEBG_API_KEY",
    "FORMA_IMAGE_MODEL"
  ],
  "frontend_files": [
    "public/design/chart-studio.html",
    "public/design/index.html",
    "public/design/smart-template-engine.js",
    "public/index.html"
  ],
  "backend_files": [
    "src/ai/service.js",
    "src/forma/asset-proxy.js",
    "src/forma/free-images.js",
    "src/forma/remove-bg.js",
    "src/index.js",
    "src/projects/service.js"
  ],
  "validation": {
    "node_syntax": "PASS",
    "forma_inline_js": "PASS",
    "chart_studio_inline_js": "PASS",
    "visible_ronda_navigation_removed": true,
    "projects_page_removed": true,
    "chart_studio_left_menu": true
  },
  "compatibility_note": "Identificadores internos históricos de projetos/templates podem permanecer para leitura de conteúdo salvo antigo; não existe aplicação, rota ou pasta Ronda One neste pacote.",
  "giphy": {
    "backend_route": "/api/giphy/search + /api/giphy/trending",
    "backend_fallback_key": true,
    "browser_fallback_on_404": true,
    "direct_api": "https://api.giphy.com/v1/gifs/*",
    "expected_fix_for_reported_404": true
  },
  "text_features": {
    "uppercase_toggle": true,
    "preserve_original_case": true,
    "text_box_toggle": true,
    "text_box_auto_follow": true,
    "box_margins": [
      "top",
      "right",
      "bottom",
      "left"
    ],
    "box_color": true,
    "png_export_support": true
  },
  "remove_bg": {
    "bundled_backend_fallback": true,
    "frontend_exposed": false,
    "env_override_supported": true
  },
  "chart_studio_ux": {
    "left_menu_item": true,
    "informational_panel_removed": true,
    "opens_directly_in_center": true,
    "right_properties_hidden_in_chart_mode": true
  },
  "color_templates": {
    "enabled": true,
    "max_colors_per_template": 6,
    "named_palettes": true,
    "edit": true,
    "delete": true,
    "persistent_local_storage": "formaDesign.colorTemplates.v1",
    "capture_project_colors": true,
    "apply_targets": {
      "text": "textColor",
      "shape": "fill",
      "mask": "borderColor",
      "nothing_selected": "artboard background"
    }
  },
  "object_deletion": {
    "properties_delete_button": true,
    "delete_key": true,
    "backspace_key": true,
    "layer_row_delete_button": true,
    "context_menu_delete": true,
    "multi_selection": true,
    "typing_guard": true
  },
  "chart_integration": {
    "mode": "integrated_artboard_element",
    "new_artboard_creation": false,
    "separate_stage_mode_removed": true,
    "chart_inserted_as": "image element with chart metadata",
    "chart_asset_kind": "chart",
    "reopen_chart_editor": true,
    "chart_studio_embed_modal": true
  },
  "chart_line_defaults": {
    "areaLineWidth_initial_px": 1,
    "applies_to": [
      "line chart",
      "area chart"
    ]
  },
  "chart_insert_flow": {
    "outer_modal_insert_button": true,
    "insert_target": "active artboard",
    "returns_to_last_non_chart_panel": true,
    "chart_remains_integrated_element": true,
    "reopen_for_edit": true,
    "return_to_editor_after_insert": true,
    "all_normal_tools_accessible_after_insert": true,
    "selected_chart_reopens_chart_studio": true,
    "same_active_artboard": true
  },
  "remove_bg_fix": {
    "backend_first": true,
    "browser_fallback_on_missing_route": true,
    "supports_local": true,
    "supports_external": true,
    "supports_proxy": true,
    "supports_original_src": true,
    "preserves_artboard_element": true,
    "mask_support": true
  }
}